# Copy this file to .env and fill in your keys. .env is gitignored — never commit it.
# All of these are FREE tiers. Do not add paid keys (no ANTHROPIC_API_KEY, no paid OpenAI).

# Free LLM APIs (https://cloud.cerebras.ai, https://console.groq.com, https://aistudio.google.com)
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# optional
OPENROUTER_API_KEY=

# Hugging Face write token (checkpoints/artifacts go to PRIVATE repos)
HF_TOKEN=
# HF namespace for private artifact repos
HF_ARTIFACT_REPO=trinath122/open-nla-audits-artifacts

# Weights & Biases (free tier)
WANDB_API_KEY=
WANDB_PROJECT=open-nla-audits
